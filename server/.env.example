MESHY_API_KEY=
JWT_SECRET=
FRONTEND_URL=
PORT=3001

# URL pública do próprio backend (ex: https://seu-servico.onrender.com),
# usada para montar o link de aprovação enviado por e-mail.
BACKEND_URL=

# Chave de API da Resend (resend.com), usada pra enviar o e-mail de aviso de
# novo pedido de acesso. Usamos a Resend (HTTPS) em vez de SMTP direto porque
# o Render bloqueia conexões de saída pelas portas de SMTP.
RESEND_API_KEY=
# E-mail que RECEBE o aviso de novo pedido de acesso — precisa ser o mesmo
# e-mail usado pra criar a conta na Resend (enquanto não tiver domínio
# próprio verificado lá).
ADMIN_EMAIL=

# Em produção (Neon, Render Postgres etc.), use uma única connection string:
DATABASE_URL=

SUPER_ADMIN_LOGIN=

# Alternativa só para desenvolvimento local, sem DATABASE_URL:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_NAME=
