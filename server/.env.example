GEMINI_API_KEY=
MESHY_API_KEY=
JWT_SECRET=
FRONTEND_URL=
PORT=3001

# URL pública do próprio backend (ex: https://seu-servico.onrender.com),
# usada para montar o link de aprovação enviado por e-mail.
BACKEND_URL=

# E-mail usado para ENVIAR o aviso de novo pedido de acesso (Gmail + senha
# de app, gerada em myaccount.google.com/apppasswords).
EMAIL_USER=
EMAIL_APP_PASSWORD=
# E-mail que RECEBE o aviso de novo pedido de acesso (pode ser o mesmo de cima).
ADMIN_EMAIL=

# Em produção (Neon, Render Postgres etc.), use uma única connection string:
DATABASE_URL=

# Alternativa só para desenvolvimento local, sem DATABASE_URL:
# DB_USER=
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=
# DB_NAME=
